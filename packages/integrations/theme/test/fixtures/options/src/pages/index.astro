<html lang="en">
	<head>
		<meta charset="utf-8" />
		<title>Options test</title>
	</head>
	<body>
		<p>resolved: <span id="resolved"></span></p>
		<p>preference: <span id="preference"></span></p>
		<p>themes: <span id="themes"></span></p>
		<button id="toggle">toggle</button>

		<script>
			import { getTheme, resolvedTheme, setTheme, themes } from '@astrojs/theme';

			document.getElementById('themes').textContent = themes.join(',');

			function render() {
				document.getElementById('preference').textContent = getTheme();
				document.getElementById('resolved').textContent = resolvedTheme();
			}

			document.getElementById('toggle').addEventListener('click', () => {
				setTheme(getTheme() === 'dark' ? 'light' : 'dark');
				render();
			});

			render();
		</script>
	</body>
</html>
